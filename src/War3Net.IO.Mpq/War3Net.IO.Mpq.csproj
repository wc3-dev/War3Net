<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(TfmGroupDotNet)</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Moonwell.War3Net.IO.Mpq</PackageId>
    <Description>Read and write MPQ archives. Moonwell's fork of War3Net.IO.Mpq.</Description>
    <PackageTags>modding;mpq;warcraft3;wc3</PackageTags>
  </PropertyGroup>

  <ItemGroup Condition="'$(PUBLISH)'!='true'">
    <ProjectReference Include="..\War3Net.IO.Compression\War3Net.IO.Compression.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(PUBLISH)'=='true'">
    <PackageReference Include="War3Net.IO.Compression" />
  </ItemGroup>

</Project>
